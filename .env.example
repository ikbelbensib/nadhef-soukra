# Copiez en .env pour le développement local.

NODE_ENV=development
PORT=3000

# libSQL : fichier local en dev, libsql://… sur Turso en production.
DATABASE_URL=file:./data/nadhef.db
# DATABASE_AUTH_TOKEN=

# Pepper du HMAC des numéros de téléphone.
# Un sha256 simple serait brute-forçable : l'espace des numéros tunisiens tient
# dans 10^8. Ce pepper ne doit JAMAIS être stocké en base ni commité.
PHONE_PEPPER=dev-pepper-a-remplacer-en-production
JWT_SECRET=dev-jwt-secret-a-remplacer-en-production

CORS_ORIGIN=*

# Fond de carte Protomaps auto-hébergé (règle #1 : pas de Google Maps).
# Sans ce fichier, l'application bascule sur un fond schématique et reste utilisable.
PMTILES_URL=/tiles/soukra.pmtiles

# Compte modérateur créé par le seed.
SEED_ADMIN_PSEUDO=admin
SEED_ADMIN_PHONE=+21620000000
